# Discord webhook สำหรับแจ้งเตือนผู้เข้าชมเว็บ
# ห้าม commit ค่าจริงลง git! ตั้งค่าจริงใน Cloudflare Pages > Settings > Environment variables
DISCORD_WEBHOOK_URL=

# Google Analytics 4 — Measurement ID เช่น G-XXXXXXXXXX (analytics.google.com)
# ขึ้นต้นด้วย PUBLIC_ เพราะต้องส่งไปฝั่ง browser
PUBLIC_GA_ID=

# Google Search Console — เฉพาะค่า content จาก meta tag verification
# (search.google.com/search-console เลือก verify แบบ "HTML tag")
PUBLIC_GSC_VERIFICATION=
