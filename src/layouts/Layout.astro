---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'ณัฐเศรษฐ สีถาพล · Phum — Portfolio' } = Astro.props;
---

<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@200;300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- BACKDROP -->
    <canvas id="stars"></canvas>
    <div class="glow g1"></div>
    <div class="glow g2"></div>
    <div class="grid-fade"></div>
    <div class="vignette"></div>

    <slot />

    <!-- แจ้งเตือน Discord เมื่อมีผู้เข้าชม (ยิง 1 ครั้งต่อ session กัน rate limit) -->
    <script>
      (() => {
        try {
          if (sessionStorage.getItem('visit-pinged')) return;
          sessionStorage.setItem('visit-pinged', '1');
        } catch {
          /* บางเบราว์เซอร์ปิด storage ก็ปล่อยให้ยิงตามปกติ */
        }
        const send = () =>
          fetch('/api/visit', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({
              path: location.pathname,
              referrer: document.referrer,
              screen: `${screen.width}x${screen.height}`,
              language: navigator.language,
            }),
          }).catch(() => {});
        if ('requestIdleCallback' in window) requestIdleCallback(send);
        else setTimeout(send, 800);
      })();
    </script>
  </body>
</html>
