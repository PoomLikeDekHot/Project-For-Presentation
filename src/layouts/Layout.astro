---
import '../styles/global.css';
import Announcement from '../components/Announcement.astro';

interface Props {
  title?: string;
}
const { title = 'ณัฐเศรษฐ สีถาพล · Phum — Portfolio' } = Astro.props;
const description =
  'พอร์ตโฟลิโอของ ณัฐเศรษฐ สีถาพล (ภูมิ) นักศึกษาวิศวกรรมคอมพิวเตอร์และหุ่นยนต์ มหาวิทยาลัยกรุงเทพ — ผลงานด้าน IoT, ระบบสมองกลฝังตัว, Edge AI และหุ่นยนต์';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://natthaseth.online');
const ogImage = new URL('/assets/avatar.jpg', Astro.site ?? 'https://natthaseth.online');
const fontHref =
  'https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap';

// SEO / Analytics — ตั้งค่าจริงใน Cloudflare Pages > Settings > Environment variables
// PUBLIC_GA_ID            = Measurement ID ของ GA4 เช่น G-XXXXXXXXXX
// PUBLIC_GSC_VERIFICATION = โค้ดจาก Google Search Console (แบบ HTML tag) เฉพาะค่า content
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const GSC_VERIFICATION = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="ณัฐเศรษฐ สีถาพล (Phum)" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#050505" />
    <link rel="canonical" href={canonical} />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts (โหลดแบบไม่บล็อก render) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontHref} />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>

    <!-- Google Analytics 4 (gtag.js) — โหลดเฉพาะเมื่อมีการตั้งค่า PUBLIC_GA_ID -->
    {
      GA_ID && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){ dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', GA_ID);
          </script>
        </Fragment>
      )
    }
  </head>
  <body>
    <!-- BACKDROP -->
    <canvas id="stars"></canvas>
    <div class="glow g1"></div>
    <div class="glow g2"></div>
    <div class="grid-fade"></div>
    <div class="vignette"></div>

    <slot />
    <Announcement />

    <script>
      /* ---------------- STARFIELD ---------------- */
      (function () {
        const cv = document.getElementById('stars') as HTMLCanvasElement | null;
        if (!cv) return;
        const ctx = cv.getContext('2d')!;
        let w: number, h: number, dpr: number,
          stars: { x: number; y: number; r: number; a: number; tw: number; vy: number; vx: number }[] = [],
          shooters: { x: number; y: number; len: number; life: number; sp: number; ang: number }[] = [];
        function resize() {
          dpr = Math.min(devicePixelRatio || 1, 2);
          w = cv!.width = innerWidth * dpr;
          h = cv!.height = innerHeight * dpr;
          cv!.style.width = innerWidth + 'px';
          cv!.style.height = innerHeight + 'px';
          const n = Math.round((innerWidth * innerHeight) / 13000);
          stars = [];
          for (let i = 0; i < n; i++) {
            stars.push({
              x: Math.random() * w, y: Math.random() * h,
              r: (Math.random() * 1.3 + 0.3) * dpr, a: Math.random(), tw: Math.random() * 0.02 + 0.004,
              vy: (Math.random() * 0.12 + 0.02) * dpr, vx: (Math.random() * 0.06 - 0.03) * dpr,
            });
          }
        }
        resize();
        addEventListener('resize', resize);
        function spawnShooter() {
          if (Math.random() < 0 && shooters.length < 2) {
            const sx = Math.random() * w * 0.7, sy = Math.random() * h * 0.4;
            shooters.push({ x: sx, y: sy, len: 0, life: 0, sp: (7 + Math.random() * 5) * dpr, ang: Math.PI * 0.18 + Math.random() * 0.1 });
          }
        }
        function frame() {
          ctx.clearRect(0, 0, w, h);
          for (const s of stars) {
            s.a += s.tw;
            const al = 0.35 + Math.abs(Math.sin(s.a)) * 0.6;
            s.y += s.vy; s.x += s.vx;
            if (s.y > h) { s.y = 0; s.x = Math.random() * w; }
            if (s.x > w) s.x = 0;
            if (s.x < 0) s.x = w;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r, 0, 6.283);
            ctx.fillStyle = 'rgba(255,255,255,' + (al * 0.34).toFixed(3) + ')';
            ctx.fill();
          }
          spawnShooter();
          for (let i = shooters.length - 1; i >= 0; i--) {
            const sh = shooters[i];
            sh.life++;
            const dx = Math.cos(sh.ang) * sh.sp, dy = Math.sin(sh.ang) * sh.sp;
            sh.x += dx; sh.y += dy;
            const tx = sh.x - dx * 9, ty = sh.y - dy * 9;
            const g = ctx.createLinearGradient(sh.x, sh.y, tx, ty);
            g.addColorStop(0, 'rgba(255,255,255,.9)');
            g.addColorStop(1, 'rgba(255,255,255,0)');
            ctx.strokeStyle = g;
            ctx.lineWidth = 1.6 * dpr;
            ctx.beginPath(); ctx.moveTo(sh.x, sh.y); ctx.lineTo(tx, ty); ctx.stroke();
            if (sh.x > w || sh.y > h || sh.life > 120) shooters.splice(i, 1);
          }
          requestAnimationFrame(frame);
        }
        frame();
      })();

      /* ---------------- SCROLL REVEAL ---------------- */
      (function () {
        const els = [...document.querySelectorAll('.reveal')];
        if (!els.length) return;
        const io = new IntersectionObserver(
          (es) => {
            es.forEach((e) => {
              if (e.isIntersecting) {
                const target = e.target as HTMLElement;
                const sibs = [...target.parentElement!.children].filter((c) => c.classList.contains('reveal'));
                const idx = sibs.indexOf(target);
                target.style.transitionDelay = Math.max(0, idx) * 0.08 + 's';
                target.classList.add('in');
                io.unobserve(target);
              }
            });
          },
          { threshold: 0.14, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <!-- แจ้งเตือน Discord เมื่อมีผู้เข้าชม (ยิง 1 ครั้งต่อ session กัน rate limit) -->
    <script>
      (() => {
        let firstVisit = false;
        try {
          if (sessionStorage.getItem('visit-pinged')) return;
          sessionStorage.setItem('visit-pinged', '1');
          firstVisit = !localStorage.getItem('visited-before');
          if (firstVisit) localStorage.setItem('visited-before', '1');
        } catch {
          /* บางเบราว์เซอร์ปิด storage ก็ปล่อยให้ยิงตามปกติ */
        }
        const send = () =>
          fetch('/api/visit', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({
              path: location.pathname,
              referrer: document.referrer,
              screen: `${screen.width}x${screen.height}`,
              language: navigator.language,
              firstVisit,
            }),
          }).catch(() => {});
        if ('requestIdleCallback' in window) requestIdleCallback(send);
        else setTimeout(send, 800);
      })();
    </script>
  </body>
</html>
