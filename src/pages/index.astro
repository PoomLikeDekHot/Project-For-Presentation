---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import BlogFeature from '../components/BlogFeature.astro';
import Footer from '../components/Footer.astro';
import Modals from '../components/Modals.astro';
---

<Layout>
  <Nav />
  <main class="wrap">
    <Hero />
    <About />
    <Projects />
    <Stack />
    <BlogFeature />
    <Footer />
  </main>

  <Modals />
</Layout>

<script>
  /* ---------------- CARD SPOTLIGHT ---------------- */
  document.querySelectorAll<HTMLElement>('.proj').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', e.clientX - r.left + 'px');
      card.style.setProperty('--my', e.clientY - r.top + 'px');
    });
  });

  /* ---------------- MODAL ---------------- */
  const modal = document.getElementById('modal')!;
  const mContent = document.getElementById('modal-content')!;
  const lb = document.getElementById('lightbox')!;
  const lbImg = lb.querySelector('img') as HTMLImageElement;
  let currentCard: HTMLElement | null = null;
  let animating = false;
  const EXP_EASE = 'cubic-bezier(.22,.7,.25,1)';

  function showPanel(key: string) {
    mContent.querySelectorAll('.m-panel').forEach((p) => {
      p.classList.toggle('active', (p as HTMLElement).dataset.panel === key);
    });
  }

  function openModal(key: string, card: HTMLElement | null) {
    if (animating) return;
    currentCard = card || null;
    showPanel(key);
    modal.classList.remove('closing');
    modal.classList.add('show');
    document.body.classList.add('locked');
    const dlg = modal.querySelector('.dialog') as HTMLElement;
    dlg.scrollTop = 0;
    dlg.style.opacity = '1';
    if (currentCard) {
      dlg.style.transition = 'none';
      dlg.style.transformOrigin = 'top left';
      dlg.style.transform = 'none';
      const cr = currentCard.getBoundingClientRect();
      const dr = dlg.getBoundingClientRect();
      const s = cr.width / dr.width;
      const tx = cr.left - dr.left, ty = cr.top - dr.top;
      dlg.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + s + ')';
      dlg.getBoundingClientRect();
      animating = true;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          dlg.style.transition = 'transform .62s ' + EXP_EASE;
          dlg.style.transform = 'none';
          setTimeout(() => { animating = false; }, 640);
        });
      });
    }
    const v = mContent.querySelector('.m-panel.active video') as HTMLVideoElement | null;
    if (v) { v.currentTime = 0; v.play().catch(() => {}); }
  }

  function closeModal() {
    if (animating) return;
    const dlg = modal.querySelector('.dialog') as HTMLElement;
    const v = mContent.querySelector('.m-panel.active video') as HTMLVideoElement | null;
    if (v) v.pause();
    modal.classList.add('closing');
    const finish = () => {
      modal.classList.remove('show');
      modal.classList.remove('closing');
      document.body.classList.remove('locked');
      mContent.querySelectorAll('.m-panel').forEach((p) => p.classList.remove('active'));
      dlg.style.transition = '';
      dlg.style.transform = '';
      dlg.style.opacity = '';
      dlg.style.transformOrigin = '';
      currentCard = null;
      animating = false;
    };
    if (currentCard) {
      const cr = currentCard.getBoundingClientRect();
      const dr = dlg.getBoundingClientRect();
      const s = cr.width / dr.width;
      const tx = cr.left - dr.left, ty = cr.top - dr.top;
      animating = true;
      dlg.style.transformOrigin = 'top left';
      dlg.style.transition = 'transform .5s cubic-bezier(.4,0,.5,1), opacity .45s';
      dlg.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + s + ')';
      dlg.style.opacity = '0';
      setTimeout(finish, 500);
    } else {
      finish();
    }
  }

  document.querySelectorAll<HTMLElement>('.proj').forEach((c) => {
    c.addEventListener('click', () => openModal(c.dataset.modal!, c));
  });
  modal.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', closeModal));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (lb.classList.contains('show')) closeLb();
      else if (modal.classList.contains('show')) closeModal();
    }
  });

  /* ---------------- LIGHTBOX ---------------- */
  function closeLb() { lb.classList.remove('show'); }
  mContent.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-zoom]') as HTMLImageElement | null;
    if (t) { lbImg.src = t.src; lb.classList.add('show'); }
  });
  lb.addEventListener('click', closeLb);
</script>
