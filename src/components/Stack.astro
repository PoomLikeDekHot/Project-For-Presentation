---
const hardware = [
  {
    name: 'Arduino / ESP32',
    desc: 'บอร์ดควบคุมหลักสำหรับ IoT และระบบฝังตัว',
    icon: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="6" y="8" width="20" height="16" rx="3"/><path d="M10 12h4M10 16h8M10 20h5"/><path d="M4 12h2M4 16h2M4 20h2M26 12h2M26 16h2M26 20h2"/></svg>',
  },
  {
    name: 'Sensors',
    desc: 'อ่านค่าความชื้น การเอียง คุณภาพอากาศ และเสียง',
    icon: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="16" cy="16" r="4"/><path d="M16 5v4M16 23v4M5 16h4M23 16h4"/><path d="M8.2 8.2 11 11M21 21l2.8 2.8M23.8 8.2 21 11M11 21l-2.8 2.8"/></svg>',
  },
  {
    name: 'Wireless IoT',
    desc: 'ส่งข้อมูลระหว่างอุปกรณ์ด้วยโมดูลไร้สาย',
    icon: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M10 20a8 8 0 0 1 12 0"/><path d="M6 16a14 14 0 0 1 20 0"/><path d="M14 24a3 3 0 0 1 4 0"/><circle cx="16" cy="27" r="1.5" fill="currentColor" stroke="none"/></svg>',
  },
  {
    name: 'Prototype Build',
    desc: 'ต่อวงจร ทดสอบ relay/ADC และขึ้นรูปชิ้นงาน 3D',
    icon: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M16 4 27 10v12l-11 6-11-6V10l11-6Z"/><path d="m5 10 11 6 11-6M16 16v12"/><path d="M11 8.2 22 14"/></svg>',
  },
];
const software = [
  {
    name: 'C / C++ Firmware',
    desc: 'เขียน logic ควบคุมบอร์ด เซ็นเซอร์ และ communication',
    icon: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m12 10-6 6 6 6M20 10l6 6-6 6"/><path d="m18 7-4 18"/></svg>',
  },
  {
    name: 'Python AI Pipeline',
    desc: 'เตรียมข้อมูลเสียง ทำ feature extraction และ evaluate model',
    icon: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="7" y="5" width="18" height="22" rx="4"/><path d="M11 11h10M11 16h6M11 21h10"/><circle cx="22" cy="21" r="1" fill="currentColor" stroke="none"/></svg>',
  },
  {
    name: 'TinyML / TFLite',
    desc: 'บีบอัดโมเดลให้รันบนอุปกรณ์ขนาดเล็กได้',
    icon: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="9" y="9" width="14" height="14" rx="3"/><path d="M13 13h6v6h-6z"/><path d="M9 4v5M14 4v5M19 4v5M23 9h5M23 14h5M23 19h5M19 23v5M14 23v5M9 23v5M4 19h5M4 14h5M4 9h5"/></svg>',
  },
  {
    name: 'Astro / Cloudflare',
    desc: 'ทำ portfolio, blog และ deploy แบบ static-first',
    icon: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 22c-2.4 0-4-1.6-4-3.7 0-2 1.4-3.5 3.4-3.7C8.2 10.8 11.6 8 15.8 8c4.6 0 8.4 3.3 9.1 7.6 1.9.4 3.1 1.8 3.1 3.5 0 1.7-1.4 2.9-3.4 2.9H8Z"/><path d="M12 25h9M15 28h3"/></svg>',
  },
];
---
<section class="sec" id="stack">
  <div class="sec-head reveal"><h2>Tech Stack</h2><div class="line"></div></div>
  <div class="stack-panels">
    <div class="card reveal">
      <div class="pad">
        <div class="label">// hardware</div>
        <div class="skill-grid">
          {hardware.map((item) => (
            <article class="skill-tile">
              <span class="skill-icon" set:html={item.icon}></span>
              <div>
                <h3>{item.name}</h3>
                <p>{item.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
    <div class="card reveal">
      <div class="pad">
        <div class="label">// software</div>
        <div class="skill-grid">
          {software.map((item) => (
            <article class="skill-tile">
              <span class="skill-icon" set:html={item.icon}></span>
              <div>
                <h3>{item.name}</h3>
                <p>{item.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
